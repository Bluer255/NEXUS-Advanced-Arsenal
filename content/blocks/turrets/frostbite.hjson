# NEXUS Frostbite - кріогенна турель. Стріляє крижаними осколками, які морозять.
# Кожен постріл = 2 снаряди (MultiBulletType): крижаний осколок (урон/заморозка) + "гасильник"
# (LiquidBulletType), який гасить пожежі на своєму шляху - саме він, а не осколок, тушить вогонь.
# Вода: осколок + малий крижаний спалах. Кріорідина: сильний крижаний вибух з уламками. Тир 1.
type: LiquidTurret
name: "NEXUS Frostbite"
description: "Fires ice shards that freeze enemies and extinguishes fires. Cryofluid creates icy bursts."
category: turret
requirements: ["copper/90", "graphite/60", "silicon/40", "titanium/30"]
research: { parent: wave }
size: 2
scaledHealth: 210
range: 160
reload: 24
rotateSpeed: 8
shootCone: 20
inaccuracy: 3
recoil: 1.2
recoilTime: 20
shootY: 7.5
liquidCapacity: 20
extinguish: true
targetAir: true
targetGround: true
shootSound: shootSalvo
heatColor: "9ee6ff"
shootEffect: [
    {
        particles: 6, length: 22, baseLength: 3, lifetime: 20, cone: 35
        sizeFrom: 2.5, sizeTo: 0, colorFrom: "ffffff", colorTo: "9ee6ff"
    }
]
smokeEffect: shootBigSmoke
ammoTypes: {
    water: {
        type: MultiBulletType
        ammoMultiplier: 3
        bullets: [
            # Гасильник: невидимий-ish водяний снаряд, гасить вогонь на шляху і на влученні
            {
                type: LiquidBulletType
                liquid: water
                speed: 6
                lifetime: 28
                damage: 0
                orbSize: 1.5
                puddleSize: 2
                collidesAir: false
            }
            # Крижаний осколок
            {
                type: BasicBulletType
                speed: 6
                damage: 9
                lifetime: 28
                width: 6
                height: 13
                backColor: "7cc0e8"
                frontColor: "ffffff"
                trailColor: "9ee6ff"
                trailLength: 7
                trailWidth: 1.6
                status: freezing
                statusDuration: 150
                statusChance: 0.6
                splashDamage: 10
                splashDamageRadius: 22
                hitColor: "9ee6ff"
                hitEffect: freezing
                despawnEffect: hitBulletColor
            }
        ]
    }
    cryofluid: {
        type: MultiBulletType
        ammoMultiplier: 2
        reloadMultiplier: 0.85
        bullets: [
            {
                type: LiquidBulletType
                liquid: cryofluid
                speed: 6
                lifetime: 28
                damage: 0
                orbSize: 1.5
                puddleSize: 2
                collidesAir: false
            }
            {
                type: BasicBulletType
                speed: 6
                damage: 12
                lifetime: 28
                width: 8
                height: 16
                backColor: "4fc3ff"
                frontColor: "ffffff"
                trailColor: "bfe6fa"
                trailLength: 9
                trailWidth: 2
                status: freezing
                statusDuration: 240
                splashDamage: 28
                splashDamageRadius: 46
                hitColor: "bfe6fa"
                # Крижаний вибух: уламки розлітаються і теж морозять
                fragBullets: 5
                fragBullet: {
                    type: BasicBulletType
                    speed: 3
                    damage: 6
                    lifetime: 18
                    width: 4
                    height: 8
                    backColor: "9ee6ff"
                    frontColor: "ffffff"
                    status: freezing
                    statusDuration: 120
                    despawnEffect: none
                    hitEffect: hitBulletColor
                }
                hitEffect: {
                    particles: 12, length: 38, lifetime: 30, sizeFrom: 3.5, sizeTo: 0
                    colorFrom: "ffffff", colorTo: "7cc0e8"
                }
                despawnEffect: hitBulletColor
            }
        ]
    }
}
drawer: {
    type: DrawTurret
    parts: [
        # Кристалічний ствол з віддачею
        { type: RegionPart, suffix: "-crystal", x: 0, y: 2.5, moveY: -1.4, progress: recoil, heatProgress: heat, heatColor: "9ee6ff" }
        # Бокові кристали-осколки
        { type: RegionPart, suffix: "-shard", x: 5.5, y: 0.5, rotation: -10, moveRot: -6, moveX: 0.4, progress: warmup }
        { type: RegionPart, suffix: "-shard", x: -5.5, y: 0.5, rotation: 10, moveRot: 6, moveX: -0.4, xScl: -1, progress: warmup }
        # Холодне світіння: обертовий шестикутник
        { type: ShapePart, sides: 6, hollow: true, radius: 3.2, radiusTo: 4.6, stroke: 0.7, strokeTo: 0.4, rotateSpeed: 1.2, color: "9ee6ff", x: 0, y: -2.2, progress: warmup, layer: 110 }
    ]
}
